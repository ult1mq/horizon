+/// Count actual jobs, including superseded sequences and unloaded columns,
+/// until their results are consumed. `meshing` only tracks the latest keys.
+#[derive(Default)]
+struct MeshJobs(usize);
+impl MeshJobs {
+    fn room(&self, workers: usize) -> usize {
+        (workers * 32).saturating_sub(self.0)
+    }
+    fn submitted(&mut self) {
+        self.0 += 1;
+    }
+    fn completed(&mut self) {
+        self.0 = self.0.checked_sub(1).expect("mesh result without a job");
+    }
+}
