+/// Candidate entries are columns, but the capacity is measured in sections.
+/// Leave the rest of a partially submitted column dirty for the next update.
+fn take_mesh_sections(world: &mut World, x: i32, z: i32, sections: u32, room: &mut usize) -> u32 {
+    let mut submitted = 0u32;
+    for sy in section_indexes(sections).take(*room) {
+        submitted |= 1 << sy;
+    }
+    *room -= submitted.count_ones() as usize;
+    world.dirty_sections.take_column(x, z);
+    for sy in section_indexes(sections & !submitted) {
+        world.dirty_sections.insert((x, sy, z));
+    }
+    submitted
+}
 #[cfg(test)]
 mod tests {
     use super::*;
+
+    #[test]
+    fn stale_and_unloaded_mesh_jobs_keep_capacity_until_the_result_arrives() {
+        let mut jobs = MeshJobs::default();
+        let mut latest = FxHashMap::default();
+        // Successive jobs for one section supersede its sequence, but each
+        // snapshot remains owned by a worker until its result is consumed.
+        for sequence in 0..32 {
+            jobs.submitted();
+            latest.insert((0, 0, 0), sequence);
+        }
+        assert_eq!(latest.len(), 1);
+        assert_eq!(jobs.room(1), 0);
+        latest.clear(); // Forget/reload invalidates keys, not outstanding jobs.
+        assert_eq!(jobs.room(1), 0);
+        for room in 1..=32 {
+            jobs.completed();
+            assert_eq!(jobs.room(1), room);
+        }
+    }
+
+    #[test]
+    fn mesh_submission_bounds_sections_and_keeps_the_remainder_dirty() {
+        let mut world = World::new(horizon_world::registry::BlockStateId(0), 0);
+        for x in 0..3 {
+            for sy in 0..SECTIONS as i32 {
+                world.dirty_sections.insert((x, sy, 0));
+            }
+        }
+        let full = (1 << SECTIONS) - 1;
+        let mut room = SECTIONS + 1;
+        assert_eq!(take_mesh_sections(&mut world, 0, 0, full, &mut room), full);
+        assert_eq!(take_mesh_sections(&mut world, 1, 0, full, &mut room), 1);
+        assert_eq!(room, 0);
+        assert_eq!(world.dirty_sections.len(), SECTIONS * 2 - 1);
+        assert!(!world.dirty_sections.contains(&(1, 0, 0)));
+        for sy in 1..SECTIONS as i32 {
+            assert!(world.dirty_sections.contains(&(1, sy, 0)));
+        }
+        // The next update can finish that column rather than losing its work.
+        let mut room = SECTIONS;
+        assert_eq!(
+            take_mesh_sections(&mut world, 1, 0, full & !1, &mut room),
+            full & !1
+        );
+        assert_eq!(room, 1);
+        assert_eq!(world.dirty_sections.len(), SECTIONS);
+    }
 
